# Copy to .env.local for local development. Next.js loads .env files from the
# project root only, and never overrides variables already present in the
# process environment — so in Docker these are supplied at runtime instead.

# --- PostgreSQL -----------------------------------------------------------
# Host is "db" under docker compose, "localhost" when running `npm run dev` on
# the host against the compose-published port.
# Consumed by the data access layer under lib/db, and by drizzle.config.ts —
# drizzle-kit runs as its own process and does not inherit Next's env loading,
# so that config reads .env.local itself. Keep the value there.
DATABASE_URL="postgresql://postgres:postgres@db:5432/weact"

# --- Server Action closure encryption -------------------------------------
# Generate with: openssl rand -base64 32
# Must be identical across every instance and build of one deployment, or
# instances cannot decrypt each other's Server Action closures.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Build-time only ------------------------------------------------------
# NEXT_PUBLIC_* values are inlined and frozen into the client bundle during
# `next build`; changing them afterwards has no effect.
# NEXT_PUBLIC_API_BASE=

# --- Admin (/admin) --------------------------------------------------------
# One shared credential for the user-management page. Read at RUNTIME, by the
# server only — never inlined into the client bundle.
#
# LEAVE THESE EMPTY IN THIS FILE. This file is committed; the values are not
# secrets once they are in git, and git history keeps them after a change.
# Put the real values in .env.local (gitignored) for `npm run dev`.
#
# Unset or blank closes the admin area entirely. That is the intended reading
# of "no password configured" — it must never mean "no password required".
#
# Changing either value signs out every open admin session.
#
# Docker note: `docker compose` interpolates from `.env`, which is a DIFFERENT
# file from the `.env.local` that Next.js loads. Compose will not see a value
# that only exists in .env.local, and the container would get an empty
# ADMIN_PASSWORD — a closed admin area with no obvious symptom. When deploying
# with compose, either create `.env` (also gitignored) or export both
# variables in the shell that runs `docker compose up`.
ADMIN_USERNAME=
ADMIN_PASSWORD=
