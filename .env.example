# Copy to .env.local for local development. Next.js loads .env files from the
# project root only, and never overrides variables already present in the
# process environment — so in Docker these are supplied at runtime instead.

# --- PostgreSQL -----------------------------------------------------------
# Not wired up yet; reserved for when the database layer lands.
# Host is "db" under docker compose, "localhost" when running `npm run dev` on
# the host against the compose-published port.
DATABASE_URL="postgresql://postgres:postgres@db:5432/weact"

# --- Server Action closure encryption -------------------------------------
# Generate with: openssl rand -base64 32
# Must be identical across every instance and build of one deployment, or
# instances cannot decrypt each other's Server Action closures.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Build-time only ------------------------------------------------------
# NEXT_PUBLIC_* values are inlined and frozen into the client bundle during
# `next build`; changing them afterwards has no effect.
# NEXT_PUBLIC_API_BASE=
